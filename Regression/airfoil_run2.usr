C-----------------------------------------------------------------------
      subroutine usrdat2

      include 'SIZE'
      include 'TOTAL'

c      set velocity BCsc
      call setbc(4,1,'v  ') ! inflow
      call setbc(2,1,'O  ') ! outflow
      call setbc(3,1,'SYM') ! bottom
      call setbc(1,1,'W  ') ! top
      call setbc(5,1,'W  ') ! airfoil

      return
      end
      
